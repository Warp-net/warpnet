<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>warpfone</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>warpfone</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Warpnet connects directly to your paired Warpnet node when both are on the same network.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>Atkinson-Hyperlegible-Regular-102.ttf</string>
		<string>OpenDyslexic-Regular.otf</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>site.warpnet.warpfone.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>AppGroup</key>
	<string>group.$(BUNDLE_ID_PREFIX).warpfone</string>
</dict>
</plist>
