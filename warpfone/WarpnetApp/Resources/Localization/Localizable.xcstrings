    "warpnet.account.bridged-%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are leaving the trusted Warpnet zone. This profile is bridged from %@. Anything you do here (tweet, reply, react, follow) leaves the peer-to-peer network and is stored on %@'s servers, where you no longer own or control that data. It also passes through the Warpnet↔Fediverse gateway, which decrypts and re-encrypts it, so it is briefly in plain text there. Moderation there is done by human administrators, not by Warpnet's automated moderation."
          }
        }
      }
    },
